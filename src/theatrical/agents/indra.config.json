{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "id": "indra",
  "title": "Integration Agent Indra Configuration",
  "description": "Configuration for Integration Director and E2E Testing Specialist - Net of Indra Connectivity Validator",
  "type": "object",
  "properties": {
    "agent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "const": "indra"
        },
        "name": {
          "type": "string",
          "const": "Integration Agent Indra"
        },
        "role": {
          "type": "string",
          "const": "integration_director"
        },
        "company": {
          "type": "string",
          "const": "devops_company"
        },
        "authority_level": {
          "type": "string",
          "const": "director"
        },
        "priority": {
          "type": "string",
          "const": "critical"
        }
      },
      "required": ["id", "name", "role", "company", "authority_level", "priority"]
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "integration_testing": {
          "type": "object",
          "properties": {
            "e2e_validation": {
              "type": "boolean",
              "const": true
            },
            "server_integration": {
              "type": "boolean", 
              "const": true
            },
            "ui_route_validation": {
              "type": "boolean",
              "const": true
            },
            "api_connectivity_testing": {
              "type": "boolean",
              "const": true
            },
            "user_workflow_validation": {
              "type": "boolean",
              "const": true
            },
            "external_service_integration": {
              "type": "boolean",
              "const": true
            },
            "production_readiness_validation": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "e2e_validation",
            "server_integration", 
            "ui_route_validation",
            "api_connectivity_testing",
            "user_workflow_validation",
            "external_service_integration",
            "production_readiness_validation"
          ]
        },
        "director_authority": {
          "type": "object",
          "properties": {
            "can_block_sprints": {
              "type": "boolean",
              "const": true
            },
            "can_request_additional_work": {
              "type": "boolean",
              "const": true
            },
            "can_modify_server_routing": {
              "type": "boolean",
              "const": true
            },
            "final_authority_feature_complete": {
              "type": "boolean",
              "const": true
            },
            "cross_agent_coordination": {
              "type": "boolean",
              "const": true
            },
            "theater_direction_powers": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "can_block_sprints",
            "can_request_additional_work",
            "can_modify_server_routing",
            "final_authority_feature_complete",
            "cross_agent_coordination",
            "theater_direction_powers"
          ]
        },
        "net_of_indra": {
          "type": "object",
          "properties": {
            "see_all_connections": {
              "type": "boolean",
              "const": true
            },
            "validate_full_web": {
              "type": "boolean",
              "const": true
            },
            "detect_missing_links": {
              "type": "boolean",
              "const": true
            },
            "strengthen_network": {
              "type": "boolean",
              "const": true
            },
            "interconnected_existence_validation": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "see_all_connections",
            "validate_full_web",
            "detect_missing_links",
            "strengthen_network",
            "interconnected_existence_validation"
          ]
        }
      },
      "required": ["integration_testing", "director_authority", "net_of_indra"]
    },
    "testing_protocols": {
      "type": "object",
      "properties": {
        "four_phase_validation": {
          "type": "object",
          "properties": {
            "pre_integration_validation": {
              "type": "boolean",
              "const": true
            },
            "server_integration_testing": {
              "type": "boolean",
              "const": true
            },
            "ui_route_validation": {
              "type": "boolean",
              "const": true
            },
            "user_experience_testing": {
              "type": "boolean", 
              "const": true
            }
          },
          "required": [
            "pre_integration_validation",
            "server_integration_testing",
            "ui_route_validation",
            "user_experience_testing"
          ]
        },
        "integration_checklist": {
          "type": "object",
          "properties": {
            "server_integration_tests": {
              "type": "boolean",
              "const": true
            },
            "ui_integration_tests": {
              "type": "boolean",
              "const": true
            },
            "external_service_integration": {
              "type": "boolean",
              "const": true
            },
            "performance_production_readiness": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "server_integration_tests",
            "ui_integration_tests", 
            "external_service_integration",
            "performance_production_readiness"
          ]
        }
      },
      "required": ["four_phase_validation", "integration_checklist"]
    },
    "external_services": {
      "type": "object",
      "properties": {
        "zeus_architecture": {
          "type": "object",
          "properties": {
            "zeus_port": {
              "type": "number",
              "enum": [3012, 3010]
            },
            "slmo42_port": {
              "type": "number",
              "const": 4001
            },
            "mcpgaia_port": {
              "type": "number",
              "const": 3003
            }
          },
          "required": ["zeus_port", "slmo42_port", "mcpgaia_port"]
        },
        "service_health_validation": {
          "type": "boolean",
          "const": true
        },
        "mock_data_strategy": {
          "type": "boolean",
          "const": true
        },
        "fallback_mechanisms": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["zeus_architecture", "service_health_validation", "mock_data_strategy", "fallback_mechanisms"]
    },
    "quality_standards": {
      "type": "object",
      "properties": {
        "integration_approval_criteria": {
          "type": "object",
          "properties": {
            "all_routes_accessible": {
              "type": "boolean",
              "const": true
            },
            "user_workflows_complete": {
              "type": "boolean",
              "const": true
            },
            "api_integration_working": {
              "type": "boolean",
              "const": true
            },
            "theme_config_functional": {
              "type": "boolean",
              "const": true
            },
            "error_handling_appropriate": {
              "type": "boolean",
              "const": true
            },
            "performance_acceptable": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "all_routes_accessible",
            "user_workflows_complete",
            "api_integration_working",
            "theme_config_functional",
            "error_handling_appropriate",
            "performance_acceptable"
          ]
        },
        "documentation_requirements": {
          "type": "boolean",
          "const": true
        },
        "partnership_historico_level": {
          "type": "number",
          "minimum": 90,
          "const": 92
        }
      },
      "required": ["integration_approval_criteria", "documentation_requirements", "partnership_historico_level"]
    },
    "collaboration": {
      "type": "object",
      "properties": {
        "with_validation_agent": {
          "type": "object",
          "properties": {
            "functionality_testing": {
              "type": "boolean",
              "const": true
            },
            "integration_before_validation": {
              "type": "boolean",
              "const": true
            },
            "reports_feed_assessment": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["functionality_testing", "integration_before_validation", "reports_feed_assessment"]
        },
        "with_backend_frontend_agents": {
          "type": "object",
          "properties": {
            "identify_missing_work": {
              "type": "boolean",
              "const": true
            },
            "request_specific_implementations": {
              "type": "boolean",
              "const": true
            },
            "iterative_revalidation": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["identify_missing_work", "request_specific_implementations", "iterative_revalidation"]
        },
        "with_zeus_architect": {
          "type": "object",
          "properties": {
            "report_architectural_issues": {
              "type": "boolean",
              "const": true
            },
            "provide_design_feedback": {
              "type": "boolean",
              "const": true
            },
            "recommend_improvements": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["report_architectural_issues", "provide_design_feedback", "recommend_improvements"]
        }
      },
      "required": ["with_validation_agent", "with_backend_frontend_agents", "with_zeus_architect"]
    },
    "theater_performance": {
      "type": "object",
      "properties": {
        "director_authority_features": {
          "type": "object",
          "properties": {
            "sprint_coordination": {
              "type": "boolean",
              "const": true
            },
            "production_quality": {
              "type": "boolean",
              "const": true
            },
            "issue_escalation": {
              "type": "boolean",
              "const": true
            },
            "timeline_management": {
              "type": "boolean",
              "const": true
            }
          },
          "required": ["sprint_coordination", "production_quality", "issue_escalation", "timeline_management"]
        },
        "net_of_indra_connectivity": {
          "type": "object",
          "properties": {
            "monitor_inter_component_relationships": {
              "type": "boolean",
              "const": true
            },
            "ensure_unified_system_function": {
              "type": "boolean",
              "const": true
            },
            "identify_connectivity_gaps": {
              "type": "boolean",
              "const": true
            },
            "request_fixes_complete_web": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "monitor_inter_component_relationships",
            "ensure_unified_system_function",
            "identify_connectivity_gaps",
            "request_fixes_complete_web"
          ]
        }
      },
      "required": ["director_authority_features", "net_of_indra_connectivity"]
    },
    "vibe_coding_integration": {
      "type": "object",
      "properties": {
        "framework_retro_compatibility": {
          "type": "boolean",
          "const": true
        },
        "devops_excellence_company": {
          "type": "boolean",
          "const": true
        },
        "sprint_s09_integration": {
          "type": "boolean",
          "const": true
        },
        "theater_modular_architecture": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "framework_retro_compatibility",
        "devops_excellence_company",
        "sprint_s09_integration",
        "theater_modular_architecture"
      ]
    }
  },
  "required": [
    "agent",
    "capabilities", 
    "testing_protocols",
    "external_services",
    "quality_standards",
    "collaboration",
    "theater_performance",
    "vibe_coding_integration"
  ]
}