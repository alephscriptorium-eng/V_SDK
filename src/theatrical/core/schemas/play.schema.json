{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://theatrical.vscode.dev/schemas/play.schema.json",
  "title": "Theatrical Play Configuration Schema",
  "description": "JSON Schema for validating theatrical play/workflow configuration files",
  "type": "object",
  "required": [
    "id",
    "name",
    "displayName",
    "category",
    "acts",
    "cast",
    "duration",
    "complexity",
    "requirements",
    "outcomes",
    "vibeCodingIntegration"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 50,
      "description": "Unique identifier for the play (kebab-case)",
      "examples": ["sprint-s09-foundation", "agent-migration-workflow", "quality-validation-play"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Internal name for the play",
      "examples": ["Sprint S09 Foundation", "Agent Migration Workflow", "Quality Validation Play"]
    },
    "displayName": {
      "type": "string", 
      "minLength": 1,
      "maxLength": 150,
      "description": "Human-readable display name for the play"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000,
      "description": "Detailed description of play purpose and workflow"
    },
    "emoji": {
      "type": "string",
      "pattern": "^[\\p{Emoji_Presentation}\\p{Emoji}\\u200d\\ufe0f\\u20e3]*$",
      "maxLength": 10,
      "description": "Emoji representation of the play",
      "examples": ["🎭", "🚀", "⚓", "🔧"]
    },
    "category": {
      "type": "string",
      "enum": ["architecture", "implementation", "validation", "documentation", "deployment", "maintenance", "crisis", "training"],
      "description": "Play category for organizational purposes"
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "order", "scenes", "duration", "objectives"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Unique identifier for the act"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Name of the act"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500,
            "description": "Description of what happens in this act"
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "description": "Order of execution (1-based)"
          },
          "scenes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/scene"
            }
          },
          "duration": {
            "type": "object",
            "required": ["estimated"],
            "properties": {
              "estimated": {
                "type": "integer",
                "minimum": 1,
                "description": "Estimated duration in minutes"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Other acts this depends on"
              },
              "parallelizable": {
                "type": "boolean",
                "default": false,
                "description": "Whether this act can run in parallel with others"
              }
            }
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 200
            },
            "description": "Objectives to achieve in this act"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Prerequisites for starting this act"
          },
          "deliverables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "type", "status"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["code", "documentation", "configuration", "analysis", "decision"]
                },
                "status": {
                  "type": "string",
                  "enum": ["created", "modified", "validated"]
                },
                "quality": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cast": {
      "type": "object",
      "required": ["roles", "assignments"],
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "importance", "requiredExpertise", "responsibilities"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "importance": {
                "type": "string",
                "enum": ["lead", "supporting", "background", "cameo"]
              },
              "requiredExpertise": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiredCapabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["project_management", "documentation", "code_generation", "architecture_decisions", "quality_validation", "sprint_blocking", "mcp_integration"]
                }
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "authority": {
                "type": "object",
                "properties": {
                  "canMakeDecisions": {
                    "type": "boolean"
                  },
                  "canBlockProgress": {
                    "type": "boolean"
                  },
                  "canOverrideOthers": {
                    "type": "boolean"
                  },
                  "reportingStructure": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "additionalProperties": false
          }
        },
        "companies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["companyId", "roles", "coordination"],
            "properties": {
              "companyId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "coordination": {
                "type": "string",
                "enum": ["internal", "external", "mixed"]
              },
              "authority": {
                "type": "string",
                "enum": ["advisory", "executive", "collaborative"]
              }
            }
          }
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["roleId", "agentId", "assignment"],
            "properties": {
              "roleId": {
                "type": "string"
              },
              "agentId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "assignment": {
                "type": "string",
                "enum": ["primary", "secondary", "backup"]
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "notes": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "duration": {
      "type": "object",
      "required": ["estimated", "minimum", "maximum"],
      "properties": {
        "estimated": {
          "type": "integer",
          "minimum": 1,
          "description": "Estimated total duration in minutes"
        },
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "description": "Minimum expected duration"
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum expected duration"
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "impact", "description"],
            "properties": {
              "name": {
                "type": "string"
              },
              "impact": {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "complexity": {
      "type": "object",
      "required": ["level", "agentCount", "parallelism", "dependencies", "skillRequirements"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["simple", "moderate", "complex", "expert"]
        },
        "agentCount": {
          "type": "object",
          "required": ["min", "max", "optimal"],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            },
            "optimal": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "parallelism": {
          "type": "string",
          "enum": ["sequential", "parallel", "mixed"]
        },
        "dependencies": {
          "type": "string",
          "enum": ["none", "few", "moderate", "complex"]
        },
        "skillRequirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "required": ["minimumAgents", "requiredRoles", "requiredExpertise"],
      "properties": {
        "minimumAgents": {
          "type": "integer",
          "minimum": 1
        },
        "requiredRoles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredExpertise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredTools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredResources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "description", "severity"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["time", "resource", "quality", "scope", "dependency"]
              },
              "description": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["soft", "hard", "critical"]
              },
              "enforcement": {
                "type": "string",
                "enum": ["warning", "blocking", "automated"]
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": "object",
      "required": ["primaryGoals", "deliverables", "successCriteria"],
      "properties": {
        "primaryGoals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 200
          }
        },
        "secondaryGoals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "type", "description", "responsible"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["code", "documentation", "configuration", "report", "decision"]
              },
              "description": {
                "type": "string"
              },
              "responsible": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acceptanceCriteria": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "qualityStandards": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "threshold"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "threshold": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "measurement": {
                      "type": "string"
                    },
                    "enforcement": {
                      "type": "string",
                      "enum": ["advisory", "blocking", "automatic"]
                    }
                  }
                }
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "target", "unit"],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["time", "quality", "efficiency", "satisfaction", "coverage"]
              },
              "target": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "measurement": {
                "type": "string",
                "enum": ["automatic", "manual", "calculated"]
              }
            }
          }
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "qualityGates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "vibeCodingIntegration": {
      "type": "object",
      "required": ["sprintIntegration", "checkpointMapping", "validationPoints"],
      "properties": {
        "sprintIntegration": {
          "type": "boolean",
          "description": "Whether play integrates with VibeCoding sprints"
        },
        "checkpointMapping": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9-]+$": {
              "type": "string"
            }
          },
          "description": "Mapping of play checkpoints to VibeCoding checkpoints"
        },
        "validationPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Points where VibeCoding validation occurs"
        },
        "reportingStructure": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "VibeCoding reporting chain"
        },
        "qualityGates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["partnership_historico", "s09_pipeline", "anti_enshittification", "documentation_standards"]
          },
          "description": "VibeCoding quality gates that apply"
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "updated": {
          "type": "string",
          "format": "date-time"
        },
        "createdBy": {
          "type": "string"
        },
        "maintainedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "partnershipHistorico": {
          "type": "object",
          "properties": {
            "validationDate": {
              "type": "string",
              "format": "date-time"
            },
            "validatedBy": {
              "type": "string"
            },
            "qualityScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "complianceLevel": {
              "type": "string",
              "enum": ["basic", "standard", "premium", "excellence"]
            }
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,

  "definitions": {
    "scene": {
      "type": "object",
      "required": ["id", "name", "actId", "order", "participants", "duration"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "actId": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["agentId", "role", "participation", "required"],
            "properties": {
              "agentId": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "role": {
                "type": "string"
              },
              "participation": {
                "type": "string",
                "enum": ["active", "passive", "observer"]
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "duration": {
          "type": "object",
          "required": ["estimated"],
          "properties": {
            "estimated": {
              "type": "integer",
              "minimum": 1
            },
            "variable": {
              "type": "boolean",
              "default": false
            },
            "factors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "dialogues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "speaker", "audience", "content"],
            "properties": {
              "id": {
                "type": "string"
              },
              "speaker": {
                "type": "string"
              },
              "audience": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "content": {
                "type": "object",
                "required": ["template"],
                "properties": {
                  "template": {
                    "type": "string"
                  },
                  "variables": {
                    "type": "object"
                  },
                  "style": {
                    "type": "string",
                    "enum": ["formal", "casual", "technical", "creative"]
                  },
                  "expectations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "timing": {
                "type": "object",
                "properties": {
                  "maxDuration": {
                    "type": "integer"
                  },
                  "expectedTurns": {
                    "type": "integer"
                  },
                  "timeout": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "performer", "type"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "performer": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["code-generation", "file-operation", "validation", "configuration", "communication", "analysis", "decision", "coordination"]
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "inputs": {
                    "type": "object"
                  },
                  "options": {
                    "type": "object"
                  },
                  "context": {
                    "type": "object"
                  }
                }
              },
              "validation": {
                "type": "object",
                "properties": {
                  "preconditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "postconditions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "fromScene", "toScene", "condition"],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "fromScene": {
                "type": "string"
              },
              "toScene": {
                "type": "string"
              },
              "condition": {
                "type": "object",
                "required": ["type", "expression"],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": ["always", "conditional", "manual", "timed"]
                  },
                  "expression": {
                    "type": "string"
                  },
                  "dependencies": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "timeout": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },

  "examples": [
    {
      "id": "sprint-s09-foundation",
      "name": "Sprint S09 Foundation", 
      "displayName": "Sprint S09-001 - Fundaciones Teatro",
      "description": "Foundational sprint for implementing theatrical system infrastructure with TypeScript interfaces, JSON schemas, and modular architecture",
      "emoji": "🏗️",
      "category": "architecture",
      "acts": [
        {
          "id": "interfaces-foundation",
          "name": "TypeScript Interfaces Foundation",
          "description": "Create core TypeScript interfaces for theatrical system",
          "order": 1,
          "scenes": [
            {
              "id": "create-core-interfaces",
              "name": "Create Core Interfaces",
              "actId": "interfaces-foundation",
              "order": 1,
              "participants": [
                {
                  "agentId": "artillero-alpha",
                  "role": "typescript-specialist",
                  "participation": "active",
                  "required": true
                }
              ],
              "duration": {
                "estimated": 45,
                "variable": false
              }
            }
          ],
          "duration": {
            "estimated": 60,
            "parallelizable": false
          },
          "objectives": [
            "Create ITheatricalAgent interface",
            "Create ICompany interface", 
            "Create IPlay interface",
            "Establish modular exports"
          ]
        }
      ],
      "cast": {
        "roles": [
          {
            "id": "typescript-specialist",
            "name": "TypeScript Specialist",
            "importance": "lead",
            "requiredExpertise": ["typescript", "interface-design", "vs-code-api"],
            "requiredCapabilities": ["code_generation", "architecture_decisions"],
            "responsibilities": ["Create TypeScript interfaces", "Ensure type safety", "Establish patterns"]
          }
        ],
        "assignments": [
          {
            "roleId": "typescript-specialist",
            "agentId": "artillero-alpha",
            "assignment": "primary",
            "confidence": 95
          }
        ]
      },
      "duration": {
        "estimated": 480,
        "minimum": 240,
        "maximum": 720
      },
      "complexity": {
        "level": "moderate",
        "agentCount": {
          "min": 2,
          "max": 5,
          "optimal": 3
        },
        "parallelism": "mixed",
        "dependencies": "moderate",
        "skillRequirements": ["typescript", "json-schema", "vs-code-extension"]
      },
      "requirements": {
        "minimumAgents": 2,
        "requiredRoles": ["typescript-specialist", "schema-engineer"],
        "requiredExpertise": ["typescript", "json-schema", "vs-code-api"]
      },
      "outcomes": {
        "primaryGoals": [
          "Complete TypeScript interface foundation",
          "Establish JSON schema validation",
          "Create modular architecture base"
        ],
        "deliverables": [
          {
            "id": "typescript-interfaces",
