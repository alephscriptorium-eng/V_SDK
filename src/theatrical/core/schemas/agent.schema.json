{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://theatrical.vscode.dev/schemas/agent.schema.json",
  "title": "Theatrical Agent Configuration Schema",
  "description": "JSON Schema for validating theatrical agent configuration files in VS Code extension",
  "type": "object",
  "required": [
    "agentId",
    "displayName", 
    "category",
    "model",
    "vibecoding",
    "personality",
    "capabilities"
  ],
  "properties": {
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "minLength": 3,
      "maxLength": 50,
      "description": "Unique identifier for the agent (kebab-case)",
      "examples": ["isaac-marinero", "astilleador-retro", "don-alvaro"]
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Human-readable name for the agent",
      "examples": ["Isaac - Marinero Fiel", "Don Álvaro - Capataz de Astilleros"]
    },
    "category": {
      "type": "string",
      "enum": ["framework-retro", "technical-devops", "validation", "custom"],
      "description": "Agent category for organizational purposes"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "AI model identifier for the agent",
      "examples": ["claude-3.5-sonnet", "gpt-4", "custom-model"]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of available tools for the agent",
      "examples": [["file_operations", "code_generation", "documentation"]]
    },
    "vibecoding": {
      "type": "object",
      "required": ["sprint_role", "validation_level", "can_block_sprint"],
      "properties": {
        "sprint_role": {
          "type": "string",
          "enum": [
            "supervisor", 
            "implementer", 
            "validator", 
            "coordinator", 
            "specialist",
            "observer"
          ],
          "description": "Role within VibeCoding sprint system"
        },
        "checkpoint_authority": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "documentation",
              "architecture", 
              "implementation",
              "testing",
              "deployment",
              "quality_gates",
              "sprint_completion"
            ]
          },
          "description": "Checkpoints the agent has authority over"
        },
        "validation_level": {
          "type": "string",
          "enum": ["documentation", "technical", "integration", "full"],
          "description": "Level of validation authority"
        },
        "can_block_sprint": {
          "type": "boolean",
          "description": "Whether agent can block sprint progression"
        },
        "reports_to": {
          "type": "string",
          "description": "Agent ID this agent reports to",
          "examples": ["don-alvaro", "captain-didac"]
        },
        "quality_gates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Quality gates this agent enforces",
          "examples": [["partnership_historico", "anti_enshittification", "documentation_standards"]]
        }
      },
      "additionalProperties": false
    },
    "mcp": {
      "type": "object",
      "properties": {
        "servers": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "MCP server endpoints the agent can connect to"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "MCP tools the agent can use"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "MCP resources the agent can access"
        },
        "customIntegrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "endpoint", "tools", "resources"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Custom integration name"
              },
              "endpoint": {
                "type": "string",
                "format": "uri",
                "description": "Custom MCP endpoint"
              },
              "tools": {
                "type": "array",
                "items": { "type": "string" }
              },
              "resources": {
                "type": "array", 
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "personality": {
      "type": "object",
      "required": ["style", "formality", "emoji_usage", "vibecoding_integration"],
      "properties": {
        "style": {
          "type": "string",
          "enum": ["technical", "nautical", "formal", "casual", "creative"],
          "description": "Communication style of the agent"
        },
        "formality": {
          "type": "string",
          "enum": ["formal", "casual", "mixed"],
          "description": "Level of formality in communication"
        },
        "emoji_usage": {
          "type": "string",
          "enum": ["none", "minimal", "moderate", "frequent"],
          "description": "Frequency of emoji usage"
        },
        "captain_relationship": {
          "type": "string",
          "enum": ["loyal_crew", "technical_expert", "independent", "supervisor"],
          "description": "Relationship dynamic with the captain"
        },
        "vibecoding_integration": {
          "type": "boolean",
          "description": "Whether personality adapts to VibeCoding context"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": [
        "project_management",
        "documentation", 
        "code_generation",
        "architecture_decisions",
        "quality_validation",
        "sprint_blocking",
        "mcp_integration"
      ],
      "properties": {
        "project_management": {
          "type": "boolean",
          "description": "Can manage projects and sprints"
        },
        "documentation": {
          "type": "boolean", 
          "description": "Can create and maintain documentation"
        },
        "code_generation": {
          "type": "boolean",
          "description": "Can generate and modify code"
        },
        "architecture_decisions": {
          "type": "boolean",
          "description": "Can make architectural decisions"
        },
        "quality_validation": {
          "type": "boolean",
          "description": "Can validate quality and enforce standards"
        },
        "sprint_blocking": {
          "type": "boolean",
          "description": "Can block sprint progression for quality issues"
        },
        "mcp_integration": {
          "type": "boolean",
          "description": "Can integrate with MCP servers and tools"
        }
      },
      "additionalProperties": false
    },
    "content_source": {
      "type": "object",
      "properties": {
        "markdown_file": {
          "type": "string",
          "description": "Path to markdown file containing agent content",
          "examples": ["agents/isaac-marinero.md", "agents/don-alvaro.md"]
        },
        "frontmatter_required": {
          "type": "boolean",
          "default": true,
          "description": "Whether YAML frontmatter is required in markdown"
        },
        "instruction_sections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Sections to extract as instructions",
          "default": ["instructions", "capabilities", "expertise"]
        }
      },
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "Semantic version of agent configuration"
        },
        "created": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updated": {
          "type": "string", 
          "format": "date-time",
          "description": "Last update timestamp"
        },
        "author": {
          "type": "string",
          "description": "Author of the agent configuration"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags for categorization and search"
        },
        "partnership_historico": {
          "type": "object",
          "properties": {
            "quality_standards": {
              "type": "number",
              "minimum": 0,
              "maximum": 100,
              "description": "Quality standards percentage (Partnership Histórico: >90%)"
            },
            "validation_date": {
              "type": "string",
              "format": "date-time",
              "description": "Last Partnership Histórico validation"
            },
            "validated_by": {
              "type": "string",
              "description": "Agent who performed validation"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  
  "examples": [
    {
      "agentId": "isaac-marinero",
      "displayName": "Isaac - Marinero Fiel del Capitán",
      "category": "framework-retro",
      "model": "claude-3.5-sonnet",
      "tools": ["file_operations", "code_generation", "project_management"],
      "vibecoding": {
        "sprint_role": "implementer",
        "checkpoint_authority": ["documentation", "implementation"],
        "validation_level": "technical",
        "can_block_sprint": false,
        "reports_to": "captain-didac",
        "quality_gates": ["partnership_historico"]
      },
      "personality": {
        "style": "nautical",
        "formality": "casual",
        "emoji_usage": "moderate",
        "captain_relationship": "loyal_crew",
        "vibecoding_integration": true
      },
      "capabilities": {
        "project_management": true,
        "documentation": true,
        "code_generation": true,
        "architecture_decisions": false,
        "quality_validation": true,
        "sprint_blocking": false,
        "mcp_integration": true
      },
      "content_source": {
        "markdown_file": "agents/isaac-marinero.md",
        "frontmatter_required": true,
        "instruction_sections": ["instructions", "capabilities", "expertise"]
      },
      "metadata": {
        "version": "1.0.0",
        "created": "2025-09-29T00:00:00Z",
        "author": "Captain Dídac San",
        "tags": ["framework-retro", "nautical", "loyal"],
        "partnership_historico": {
          "quality_standards": 95,
          "validation_date": "2025-09-29T00:00:00Z",
          "validated_by": "don-alvaro"
        }
      }
    }
  ]
}