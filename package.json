  "main": "./dist/extension.js",
  "scripts": {
    "compile": "npm run esbuild-base -- --sourcemap",
    "compile:production": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node:crypto --format=cjs --platform=node",
    "probe:v07": "node scripts/probes/v07-identidad-lectura.mjs",
    "probe:v08:build": "esbuild src/mutation/parseEditorInfo.ts --bundle --format=esm --platform=node --external:vscode --outfile=out/probe/parseEditorInfo.mjs",
    "probe:v08": "npm run probe:v08:build && node scripts/probes/v08-mutacion-autoria.mjs",
    "probe:v09": "node scripts/probes/v09-elenco-separacion.mjs",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "vscode:prepublish": "npm run compile:production",
    "package:local": "node scripts/vsix.mjs package --local",
    "compile:tests": "tsc -p tsconfig.json",
    "test": "jest",
    "test:exthost": "npm run compile && node tests/exthost/runTests.js",
    "test:exthost:vsix": "npm run package:v1 && node tests/exthost/runTests.js --vsix",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:performance": "jest tests/performance",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "package": "npm run package:v1",
    "install:local": "node scripts/vsix.mjs install",
    "uninstall:local": "code --uninstall-extension scriptorium.aleph-0",
    "build:local": "npm run compile && npm run package:local",
    "deploy:local": "npm run build:local && npm run uninstall:local && npm run install:local",
    "dev:quick": "npm run compile && npm run deploy:local",
    "install:insiders": "node scripts/vsix.mjs install --insiders",
    "uninstall:insiders": "code-insiders --uninstall-extension scriptorium.aleph-0",
    "deploy:insiders": "npm run build:local && npm run uninstall:insiders && npm run install:insiders",
    "dev:insiders": "npm run compile && npm run deploy:insiders",
    "debug:view": "code --extensionDevelopmentPath=. --new-window",
    "dev:tools": "echo 'Ctrl+Shift+I'",
    "skills:sync": "alephscript-skills-sync --runtime claude",
    "package:v1": "npm run compile:production && node scripts/vsix.mjs package",
    "vsix:path": "node scripts/vsix.mjs path"
  },
  "devDependencies": {
    "@alephscript/skills-scriptorium": ">=0.11.0 <1.0.0",
    "@types/express": "^5.0.3",
