    "configuration": {
      "title": "Aleph-0",
      "properties": {
        "aleph0.ciudad.host": {
          "type": "string",
          "default": "",
          "description": "Host donde escucha el runtime de la Ciudad (socket-server de Z). Vacío = ⏳ pendiente de configurar.",
          "scope": "window"
        },
        "aleph0.ciudad.port": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Puerto donde escucha el runtime de la Ciudad (socket-server de Z). Vacío/null = ⏳ pendiente.",
          "scope": "window"
        },
        "aleph0.ciudad.baseUrl": {
          "type": "string",
          "default": "",
          "description": "URL base HTTP del runtime de la Ciudad. Si vacío, se compone de aleph0.ciudad.host + aleph0.ciudad.port; si ambos vacíos = ⏳.",
          "scope": "window"
        },
        "aleph0.room.id": {
          "type": "string",
          "default": "",
          "description": "Room (canal del socket-server de Z) a la que el IDE hace join para recibir peercard. Vacío = ⏳ pendiente.",
          "scope": "window"
        },
        "aleph0.pieza.launcher.host": {
          "type": "string",
          "default": "",
          "description": "Host de la pieza launcher de Z (publica el catálogo). Vacío = ⏳ pendiente.",
          "scope": "window"
        },
        "aleph0.pieza.launcher.port": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Puerto de la pieza launcher de Z. Vacío/null = ⏳ pendiente.",
          "scope": "window"
        },
        "aleph0.pieza.lineaEditor.host": {
          "type": "string",
          "default": "",
          "description": "Host de la pieza @zeus/linea-editor. Vacío = resolver desde el catálogo del launcher; sin inventar.",
          "scope": "window"
        },
        "aleph0.pieza.lineaEditor.port": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Puerto de la pieza @zeus/linea-editor. Vacío/null = catálogo o ⏳; no se inventa ningún puerto.",
          "scope": "window"
        },
        "aleph0.pieza.reparto.path": {
          "type": "string",
          "default": "",
          "description": "Ruta al JSON reparto/1 (pieza @zeus/reparto-kit) que alimenta el panel elenco. Vacío = ⏳. SEPARADO de ICompany/teatro.",
          "scope": "window"
        },
        "aleph0.mcp.configPath": {
          "type": "string",
          "default": "",
          "description": "Ruta al fichero heredado que declara las piezas MCP locales (ópera). Vacío = se busca en la raíz del workspace (convención legada, pendiente de barrer).",
          "scope": "window"
        },
        "aleph0.superficie.statusBar.visible": {
          "type": "boolean",
          "default": true,
          "description": "Muestra u oculta los accesos rápidos de los paneles en la barra de estado (superficie de periferia)."
        },
        "aleph0.logging.level": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "description": "Minimum log level to display"
        },
        "aleph0.logging.enabledCategories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "general",
              "process",
              "terminal",
              "mcp",
              "socket",
              "config",
              "ui",
              "extension"
            ]
          },
          "default": [
            "general",
            "process",
            "terminal",
            "mcp",
            "socket",
            "config",
            "ui",
            "extension"
          ],
          "description": "Log categories to enable"
        },
        "aleph0.logging.showTimestamp": {
          "type": "boolean",
          "default": true,
          "description": "Show timestamp in log entries"
        },
        "aleph0.logging.showLevel": {
          "type": "boolean",
          "default": true,
          "description": "Show log level in log entries"
        },
        "aleph0.logging.showCategory": {
          "type": "boolean",
          "default": true,
          "description": "Show category in log entries"
        },
        "aleph0.logging.showSource": {
          "type": "boolean",
          "default": true,
          "description": "Show source in log entries"
        },
        "aleph0.logging.maxEntries": {
          "type": "number",
          "default": 10000,
          "description": "Maximum number of log entries to keep in memory"
        }
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "aleph0.mcptree.start",
          "when": "view == alephscript.mcptree && viewItem == serverStopped",
          "group": "inline@1"
        },
        {
          "command": "aleph0.mcptree.stop",
          "when": "view == alephscript.mcptree && viewItem == serverRunning",
          "group": "inline@1"
        },
        {
          "command": "aleph0.mcptree.web.open",
          "when": "view == alephscript.mcptree && viewItem == web",
          "group": "inline@1"
        },
        {
          "command": "aleph0.sockets.joinRoom",
          "when": "view == alephscript.sockets && viewItem == socketRoom",
          "group": "inline@1"
        },
        {
          "command": "aleph0.sockets.leaveRoom",
          "when": "view == alephscript.sockets && viewItem == socketRoom",
          "group": "inline@2"
        },
        {
          "command": "aleph0.sockets.sendMessage",
          "when": "view == alephscript.sockets && viewItem == socketRoom",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.sockets.connect",
          "when": "view == alephscript.sockets && viewItem == socketServer",
          "group": "inline@1"
        },
        {
          "command": "aleph0.sockets.disconnect",
          "when": "view == alephscript.sockets && viewItem == socketServer",
          "group": "inline@2"
        },
        {
          "command": "aleph0.configs.validate",
          "when": "view == alephscript.configs && viewItem =~ /^configFile/",
          "group": "inline@1"
        },
        {
          "command": "aleph0.configs.format",
          "when": "view == alephscript.configs && viewItem =~ /^configFile/",
          "group": "inline@2"
        },
        {
          "command": "aleph0.configs.backup",
          "when": "view == alephscript.configs && viewItem =~ /^configFile/",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.configs.reload",
          "when": "view == alephscript.configs && viewItem =~ /^configFile/",
          "group": "navigation@2"
        },
        {
          "command": "aleph0.teatro.activateAgent",
          "when": "view == alephscript.teatro && viewItem == teatroAgentInactive",
          "group": "inline@1"
        },
        {
          "command": "aleph0.teatro.deactivateAgent",
          "when": "view == alephscript.teatro && viewItem == teatroAgentActive",
          "group": "inline@1"
        },
        {
          "command": "aleph0.teatro.openChatParticipant",
          "when": "view == alephscript.teatro && viewItem =~ /^teatroAgent/",
          "group": "inline@2"
        },
        {
          "command": "aleph0.teatro.showAgentInfo",
          "when": "view == alephscript.teatro && viewItem =~ /^teatroAgent/",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "aleph0.hackerControlPanel.toggle",
          "when": "view == alephscript.hackerControlPanel",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.hackerCommandPanel.toggle",
          "when": "view == alephscript.hackerCommandPanel",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.hackerConfigPanel.toggle",
          "when": "view == alephscript.hackerConfigPanel",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.hackerTasksPanel.toggle",
