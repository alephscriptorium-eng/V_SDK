          "type": "string",
          "default": "",
          "description": "Room Zeus a la que el IDE hace join para recibir peer-card (vacío = ⏳ pendiente)",
          "scope": "window"
        },
        "zigurat.lineaEditor.host": {
          "type": "string",
          "default": "",
          "description": "Host de @zeus/linea-editor (vacío = resolver desde catálogo launcher; sin inventar)",
          "scope": "window"
        },
        "zigurat.lineaEditor.port": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Puerto de @zeus/linea-editor (vacío/null = catálogo o ⏳; no se inventa 4115)",
          "scope": "window"
        },
        "zigurat.reparto.path": {
          "type": "string",
          "default": "",
          "description": "Path a JSON reparto/1 (@zeus/reparto-kit) para el panel elenco / cast-table (vacío = ⏳). SEPARADO de ICompany/teatro.",
          "scope": "window"
        },
        "alephscript.configurationFile": {
          "type": "string",
          "default": "",
          "description": "Path to the Arrakis Theater configuration file (ArrakisTheater_OperaConfig.json)",
          "scope": "window"
        },
