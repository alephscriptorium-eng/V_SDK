          "type": "string",
          "default": "",
          "description": "Path to the MCP configuration file (legacy setting)",
          "scope": "window"
        },
        "alephscript.autoLoadConfig": {
          "type": "boolean",
          "default": true,
          "description": "Automatically load configuration file on extension startup",
          "scope": "window"
        },
        "alephscript.configValidation": {
          "type": "boolean",
          "default": true,
          "description": "Enable configuration validation on load",
          "scope": "window"
        },
        "arrakisTheater.configPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Theater configuration file"
