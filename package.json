        "zigurat.mesh.baseUrl": {
          "type": "string",
          "default": "",
          "description": "URL base HTTP del mesh (p. ej. http://localhost:3010). Si vacío, se compone de zigurat.mesh.host + zigurat.mesh.port; si ambos vacíos = ⏳",
          "scope": "window"
        },
        "zigurat.launcher.host": {
          "type": "string",
          "default": "",
          "description": "Host del MCP service launcher (vacío = ⏳ pendiente)",
          "scope": "window"
        },
        "zigurat.launcher.port": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
