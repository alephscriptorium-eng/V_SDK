        },
        {
          "command": "aleph0.hackerTasksPanel.refresh",
          "when": "view == alephscript.hackerTasksPanel",
          "group": "navigation@2"
        },
        {
          "command": "aleph0.hackerTasksPanel.stopAll",
          "when": "view == alephscript.hackerTasksPanel",
          "group": "navigation@3"
        },
        {
          "command": "aleph0.mcptree.refresh",
          "when": "view == alephscript.mcptree",
          "group": "navigation"
        },
        {
          "command": "aleph0.uis.refresh",
          "when": "view == alephscript.uis",
          "group": "navigation"
        },
        {
          "command": "aleph0.configs.refresh",
          "when": "view == alephscript.configs",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.configs.createTemplate",
          "when": "view == alephscript.configs",
          "group": "navigation@2"
        },
        {
          "command": "aleph0.sockets.refresh",
          "when": "view == alephscript.sockets",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.sockets.connect",
          "when": "view == alephscript.sockets",
          "group": "navigation@2"
        },
        {
          "command": "aleph0.logs.refresh",
          "when": "view == alephscript.logs",
          "group": "navigation@1"
        },
        {
          "command": "aleph0.logs.clear",
          "when": "view == alephscript.logs",
          "group": "navigation@2"
        },
        {
          "command": "aleph0.logs.toggleAutoRefresh",
