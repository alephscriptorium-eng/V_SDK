  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.build.json",
    "compile:tests": "tsc -p tsconfig.json",
    "watch": "tsc -watch -p tsconfig.build.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:performance": "jest tests/performance",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "package": "vsce package",
    "package:local": "vsce package --out mcp-arrakis-theater-ext.vsix",
    "install:local": "code --install-extension mcp-arrakis-theater-ext.vsix",
    "uninstall:local": "code --uninstall-extension arrakis-theater.arrakis-theater-chat",
    "build:local": "npm run compile && npm run package:local",
    "deploy:local": "npm run build:local && npm run uninstall:local && npm run install:local",
    "dev:quick": "npm run compile && npm run deploy:local",
    "debug:view": "code --extensionDevelopmentPath=c:/Users/oracl/Documents/REPOS/mcp-vscode-ext --new-window",
	  "unix:code": "sh ./setup-vscode-path",
    "dev:tools": "echo 'Ctrl+Shift+I'"
  },
