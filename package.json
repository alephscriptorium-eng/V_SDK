{
  "name": "arrakis-theater-chat",
  "displayName": "🎭 Arrakis Theater Chat Engine",
  "description": "The central STAGE of the Arrakis Theater ecosystem - where live-coding performers orchestrate AI agents with hacker aesthetics. Features Indra & Zeus-Architect agents, Framework Retro integration, and MCP protocol support for theatrical development sessions.",
  "version": "1.0.0",
  "publisher": "arrakis-theater",
  "repository": {
    "type": "git",
    "url": "https://github.com/escrivivir-co/arrakis-theater-chat.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Chat",
    "AI",
    "Other"
  ],
  "keywords": [
    "theater",
    "arrakis",
    "chat",
    "ai",
    "agents",
    "mcp",
    "hacker",
    "neural-network",
    "live-coding",
    "orchestration",
    "framework-retro",
    "indra",
    "zeus-architect"
  ],
  "icon": "./media/arrakis-theater-icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
