    "@types/node": "^24.3.1",
    "@types/vscode": "1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.57.0",
    "generator-code": "^1.11.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2",
    "yo": "^5.1.0"
  },
  "dependencies": {
    "@alephscript/mcp-core-sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
